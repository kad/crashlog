# syntax=docker/dockerfile:1
# Copyright (C) 2025 Intel Corporation
# SPDX-License-Identifier: MIT
#
# Builds the RPM packages from the tarballs produced by Dockerfile.source, by way of a source RPM,
# and runs rpmlint over the result. The container is started without network access, which is what
# proves that the build resolves every dependency from the vendored sources.
ARG BASE_IMAGE=fedora:latest
FROM ${BASE_IMAGE}

# Set to 1 to build the UEFI application as well. It needs a rustup managed toolchain, so rustup is
# installed here and the build container has to be given network access; see packaging/README.md.
ARG WITH_EFI=0

RUN set -eux; \
    dnf -y install --setopt=install_weak_deps=False \
        'dnf-command(builddep)' \
        rpm-build \
        rpmlint \
        tar \
        xz; \
    dnf clean all

# The spec of the revision being built, copied in on its own so that this layer is only rebuilt when
# the build dependencies change. dnf resolves them from the spec itself, so that this file never has
# to repeat the list.
COPY packaging/rpm/intel-crashlog.spec /tmp/intel-crashlog.spec
RUN set -eux; \
    dnf -y builddep --setopt=install_weak_deps=False --spec /tmp/intel-crashlog.spec; \
    dnf clean all; \
    rm -f /tmp/intel-crashlog.spec; \
    rustc --version; \
    cargo --version

# No toolchain is installed here: the spec installs the one it needs, for the x86_64-unknown-uefi
# target, under the build directory.
RUN set -eux; \
    if [ "$WITH_EFI" = 1 ]; then \
        dnf -y install rustup || { \
            dnf -y install curl; \
            curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | \
                sh -s -- -y --no-modify-path --profile minimal --default-toolchain none; \
        }; \
        dnf clean all; \
    fi
ENV PATH="/root/.cargo/bin:${PATH}"

COPY packaging/docker/build-rpm.sh /usr/local/bin/build-rpm
RUN chmod 0755 /usr/local/bin/build-rpm

# The tarballs are bind mounted read only on /in, the packages are written to /out.
WORKDIR /work
ENTRYPOINT ["/usr/local/bin/build-rpm"]
